PROJECT_NAME="RoadSafe Backend API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="roadasafe-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Gunakan PostgreSQL (Supabase / lokal) atau SQLite untuk development lokal
# Contoh URL PostgreSQL Supabase (lihat menu Project Settings -> Database di Supabase):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
DATABASE_URL="sqlite:///./roadasafe.db"

# Supabase Storage & Services
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"
SUPABASE_BUCKET="reports"

# Thresholds
DEDUPLICATION_RADIUS_METERS=15.0
MAX_GPS_ACCURACY_METERS=20.0
RATE_LIMIT_PER_MINUTE=60

